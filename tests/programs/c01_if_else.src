// TEST: if/else (the conditional example from the project statement) and if without else
int x;
int y;
int z;
x = 2;
y = 5;
if (x < y) { z = 1; } else { z = 0; }
print(z);           // 1

if (x > y) { z = 1; } else { z = 0; }
print(z);           // 0

if (x == 2) {
    print(222);     // printed
}
if (x == 3) {
    print(333);     // not printed
}
print(999);         // 999
