// TEST: nested loops and an else-if chain inside a loop
int i;
int j;
int total;
int score;

// sum of i*j for i, j in 1..3  = (1+2+3)^2 = 36
i = 1;
total = 0;
while (i <= 3) {
    j = 1;
    while (j <= 3) {
        total = total + i * j;
        j = j + 1;
    }
    i = i + 1;
}
print(total);           // 36

// classify scores 95, 75, 40 -> 3, 2, 1
score = 95;
while (score > 0) {
    if (score >= 90) {
        print(3);
    } else if (score >= 70) {
        print(2);
    } else {
        print(1);
    }
    if (score == 95) { score = 75; } else if (score == 75) { score = 40; } else { score = 0; }
}
